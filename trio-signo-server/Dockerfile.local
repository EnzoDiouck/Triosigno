# Serveur NestJS de TrioSigno, version locale
FROM node:22-bookworm-slim
WORKDIR /usr/src/app
RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
# @nestjs/serve-static 5 exige NestJS 11 alors que le projet est en NestJS 10 :
# on installe la version 4, compatible, sinon "npm install" échoue (conflit de dépendances).
RUN npm pkg set "dependencies.@nestjs/serve-static=^4.0.2" \
 && npm install --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN node patch-server.cjs
RUN mkdir -p assets && npx prisma generate && npm run build
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
